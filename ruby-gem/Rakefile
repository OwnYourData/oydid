#!/usr/bin/env ruby
$:.unshift(File.expand_path(File.join(File.dirname(__FILE__), 'lib')))
require 'rubygems'
require 'fileutils'

namespace :gem do
  desc "Build the oydid-#{File.read('VERSION').chomp}.gem file"
  task :build do
    # gem build copies the on-disk file mode into the archive and RubyGems
    # restores it on install. A source file that happens to be 0600 locally is
    # then unreadable for every non-root consumer - that is how 0.6.5 and 0.6.6
    # shipped an unloadable lib/oydid/log.rb. git cannot catch this: it only
    # tracks the executable bit.
    #
    # The spec globs mirror gem.test_files in oydid.gemspec - those files end up
    # in the archive too, and 0.7.0 was first built with two of them at 0600.
    FileUtils.chmod(0644, Dir.glob('lib/**/*.rb') +
                          Dir.glob('spec/**/*.{rb,json,doc}') +
                          %w(AUTHORS README.md LICENSE VERSION))
    FileUtils.mkdir_p('pkg')
    sh "gem build oydid.gemspec && mv oydid-#{File.read('VERSION').chomp}.gem pkg/"
  end

  desc "Build and install the gem locally (dev loop against repository/)"
  task :install => :build do
    # --no-document skips RubyGems' rdoc/ri generation. Nobody reads the local
    # rdoc of this gem, it costs seconds on every dev cycle, and with more than
    # one rdoc version installed it prints a wall of
    # "warning: already initialized constant RDoc::..." lines.
    sh "gem install --no-document pkg/oydid-#{File.read('VERSION').chomp}.gem"
  end

  desc "Release the oydid-#{File.read('VERSION').chomp}.gem file"
  task :release do
    sh "gem push pkg/oydid-#{File.read('VERSION').chomp}.gem"
  end
end

desc 'Default: run specs.'
task default: :spec
task specs: :spec

require 'rspec/core/rake_task'
desc 'Run specifications'
RSpec::Core::RakeTask.new do |spec|
  spec.rspec_opts = %w(--options spec/spec.opts) if File.exist?('spec/spec.opts')
end

desc "Run specifications for continuous integration"
RSpec::Core::RakeTask.new("spec:ci") do |spec|
  spec.rspec_opts = %w(--options spec/spec.opts) if File.exists?('spec/spec.opts')
end
