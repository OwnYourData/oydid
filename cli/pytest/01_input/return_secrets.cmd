( RSTMP=$(mktemp -d); $OYDIDCMD create --doc-pwd rsPwd1 --rev-pwd rsPwd2 -z 1 --json-output --return-secrets > "$RSTMP/out.json" && jq -c '{did: .did, private_key: .private_key, revocation_key: .revocation_key, revoke_op: .log_revoke.op}' "$RSTMP/out.json" && if [ -e zQmWP8BmwV_private_key.enc ]; then echo keyfiles:yes; else echo keyfiles:no; fi && jq -r .private_key "$RSTMP/out.json" > "$RSTMP/doc_key" && jq -r .revocation_key "$RSTMP/out.json" > "$RSTMP/rev_key" && $OYDIDCMD delete $(jq -r .did "$RSTMP/out.json") --doc-key "$RSTMP/doc_key" --rev-key "$RSTMP/rev_key"; RC=$?; rm -rf "$RSTMP"; exit $RC )