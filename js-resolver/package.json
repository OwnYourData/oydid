{
  "name": "oydid-did-resolver",
  "version": "0.3.0",
  "description": "did:oyd resolver plugin for did-resolver",
  "author": "Gabriel Unterholzer",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OwnYourData/oydid.git",
    "directory": "js-resolver"
  },
  "homepage": "https://ownyourdata.github.io/oydid/",
  "bugs": {
    "url": "https://github.com/OwnYourData/oydid/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "keywords": [
    "did:oyd",
    "DID",
    "DID document",
    "DID resolution",
    "did-resolver",
    "decentralized identifiers",
    "resolver",
