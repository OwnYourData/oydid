    "test:live": "npm run build && OYDID_LIVE=1 node --test",
    "prepublishOnly": "npm run clean && npm test"
  },
  "peerDependencies": {
    "did-resolver": "^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "did-resolver": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "did-resolver": "^5.0.1",
    "typescript": "^5.9.3"
  }
